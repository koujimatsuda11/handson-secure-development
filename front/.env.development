# API設定
VITE_API_BASE_URL=/api

# AWS Cognito設定（開発デプロイ後に設定）
VITE_AWS_REGION=ap-northeast-1
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_example
VITE_COGNITO_CLIENT_ID=example-client-name
VITE_COGNITO_ENDPOINT=/cognito

# AWS Access Keys
VITE_AWS_ACCESS_KEY=your_aws_access_key
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key